  "transform": [
    {"calculate": "datum.Rank2025 - datum.Rank2024", "as": "RankChange"},
    {
      "calculate": "datum.RankChange < 0 ? 'Moved up ' + (-datum.RankChange) + ' ranks' : datum.RankChange > 0 ? 'Dropped ' + datum.RankChange + ' ranks' : 'No change'",
      "as": "MovementText"
    },
    {
      "calculate": "datum.RankChange == 0 ? 'No change' : ''",
      "as": "OnPlotLabel"
    }
  ],
  "encoding": {
    "y": {
      "field": "School",
      "type": "nominal",
      "sort": {"field": "RankChange", "order": "ascending"},
      "title": "School"
    },
    "x": {
      "field": "RankChange",
      "type": "quantitative",
      "title": "Rank Change",
      "scale": {"domain": [-70, 70]}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar"},
      "encoding": {
        "color": {
          "condition": [
            {"test": "datum.RankChange < 0", "value": "#009E73"},
            {"test": "datum.RankChange > 0", "value": "#CC7987"},
            {"test": "datum.RankChange == 0", "value": "#999999"}
          ],
          "value": "#999999"
        },
        "tooltip": [
          {"field": "School", "title": "School"},
          {"field": "Rank2024", "title": "Rank 2024"},
          {"field": "Rank2025", "title": "Rank 2025"},
          {"field": "MovementText", "title": "Change"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#444444"
      },
      "encoding": {
        "text": {"field": "OnPlotLabel"},
        "opacity": {
          "condition": {"test": "datum.OnPlotLabel != ''", "value": 1},
          "value": 0
        }
      }
    }
  ],
  "config": {}
